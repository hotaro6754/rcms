# Production settings. Copy to deploy/.env on the server (never commit it) and fill in.
# Generate secrets with:  openssl rand -base64 32

# --- Your domain -------------------------------------------------------------------
SITE_DOMAIN=rcmexcel.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=admin@rcmexcel.com
NEXT_PUBLIC_APP_URL=https://rcmexcel.com
BETTER_AUTH_URL=https://rcmexcel.com
# Leave "off" until the content is final and the legal pages have been reviewed; "on" lets
# search engines index the public pages.
SITE_INDEXING=off

# --- Database ----------------------------------------------------------------------
# Option A, managed PostgreSQL (recommended): paste the provider's connection string, with
# ?sslmode=require, and leave COMPOSE_PROFILES empty.
# Option B, PostgreSQL on this server: set COMPOSE_PROFILES=localdb and a long POSTGRES_PASSWORD.
COMPOSE_PROFILES=
POSTGRES_PASSWORD=
# Option B's address:  postgresql://rcmexcel:<POSTGRES_PASSWORD>@127.0.0.1:5432/rcmexcel
DATABASE_URL=
# DATABASE_POOL_MAX=10

# --- Secrets (required) --------------------------------------------------------------
BETTER_AUTH_SECRET=
CRON_SECRET=

# --- First administrator ---------------------------------------------------------------
# Sign up on the live site as admin@rcmexcel.com with your own password and verify the email,
# then run `deploy/deploy.sh admin admin@rcmexcel.com`. Leave this empty: it is an alternative
# that works only while no owner or Super Administrator exists.
OWNER_EMAILS=

# --- Email (Resend). Without a key no email is sent: sign-up verification will not arrive. ---
RESEND_API_KEY=
EMAIL_FROM="RCMExcel <no-reply@rcmexcel.com>"

# --- Payments (Razorpay). Leave empty until tested end to end in test mode. --------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Invoices --------------------------------------------------------------------------
BUSINESS_LEGAL_NAME=
BUSINESS_GSTIN=
BUSINESS_SAC=

# --- Optional Google sign-in -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backups (deploy/backup.sh) ----------------------------------------------------------
BACKUP_KEEP_DAYS=14
