# HTTPS for the site. Caddy obtains and renews the certificate itself once DNS points here.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# One address for search engines and cookies: www sends visitors to the main domain.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
