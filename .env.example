# Copy to .env and fill in. Never commit real values. Variables marked (required) must be set
# in every environment; the rest switch features on and the app degrades honestly without them.

# --- Core (required) ----------------------------------------------------------
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/rcms_dev"
# 32+ random bytes, e.g. `openssl rand -base64 32`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=""
# The public origin of this deployment, e.g. https://academy.example.com
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# DATABASE_POOL_MAX=10

# --- First administrator --------------------------------------------------------
# Either run `npm run admin:bootstrap -- you@example.com` once, or list an address here: it
# becomes the owner at sign-up only while the platform has no owner or Super Administrator.
OWNER_EMAILS=""

# --- Security ------------------------------------------------------------------
# Staff need two-step verification to open the admin area. Defaults to true in production.
# ADMIN_MFA_REQUIRED="true"
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=15
# Set to "off" only in automated tests.
# AUTH_RATE_LIMIT="on"
# TERMS_VERSION="2026-10"

# --- Email (Resend). Without a key, emails are printed to the console in development and not sent at all in production. -----
RESEND_API_KEY=""
EMAIL_FROM="RCMS Operations Academy <academy@example.com>"

# --- Payments (Razorpay). Without keys, paid checkout is disabled. --------------
# Use test-mode keys until the integration has been tested end to end with the provider.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From the Razorpay dashboard webhook settings; the endpoint is /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# --- Invoices --------------------------------------------------------------------
BUSINESS_LEGAL_NAME=""
BUSINESS_GSTIN=""
BUSINESS_SAC=""

# --- Scheduled jobs: the scheduler calls GET /api/cron with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# --- Optional Google sign-in ----------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
