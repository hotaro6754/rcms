# Copy to .env and fill in. Never commit real values. Variables marked (required) must be set
# in every environment; the rest switch features on and the app degrades honestly without them.

# --- Core (required) ----------------------------------------------------------
# MySQL or MariaDB: mysql://user:password@host:3306/database (password %-encoded if it has symbols)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/rcmexcel_dev"
# 32+ random bytes, e.g. `openssl rand -base64 32`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=""
# The public origin of this deployment, e.g. https://academy.example.com
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# DATABASE_POOL_MAX=5
# Where uploads are kept. Default ./storage. Set it outside the app folder on hosts that replace
# the app folder on every deploy (Hostinger's Node.js hosting).
# STORAGE_DIR=

# --- First administrator --------------------------------------------------------
# Either run `npm run admin:bootstrap -- you@example.com` once, or list an address here: it
# becomes the owner at sign-up only while the platform has no owner or Super Administrator.
OWNER_EMAILS=""

# --- Security ------------------------------------------------------------------
# Staff need two-step verification to open the admin area. Defaults to true in production.
# ADMIN_MFA_REQUIRED="true"
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=15
# Set to "off" only in automated tests.
# AUTH_RATE_LIMIT="on"
# TERMS_VERSION="2026-10"

# --- Email. Either an SMTP mailbox (e.g. Hostinger: smtp.hostinger.com, port 465) or Resend.
# Without either, emails are printed to the console in development and not sent at all in production.
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="RCMExcel <no-reply@rcmexcel.com>"

# --- Payments (Razorpay). Without keys, paid checkout is disabled. --------------
# Use test-mode keys until the integration has been tested end to end with the provider.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From the Razorpay dashboard webhook settings; the endpoint is /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# --- Invoices --------------------------------------------------------------------
BUSINESS_LEGAL_NAME=""
BUSINESS_GSTIN=""
BUSINESS_SAC=""

# --- Scheduled jobs: the scheduler calls GET /api/cron with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# --- Optional Google sign-in ----------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Learning assistant (optional) -------------------------------------------------------------
# Without these the assistant answers by quoting approved material; nothing else depends on them.
# The external provider receives only the learner's masked question and approved teaching passages,
# never personal records. Turn it on only after that data flow has been approved.
# ASSISTANT_PROVIDER=anthropic
# ASSISTANT_EXTERNAL_APPROVED=true
# ASSISTANT_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
