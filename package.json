{
  "name": "rcms-operations-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "audit:ownership": "node scripts/audit-ownership.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:dev": "node scripts/dev-db.mjs",
    "db:dev:fresh": "node scripts/dev-db.mjs --fresh",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "dev:accounts": "tsx scripts/dev-accounts.ts",
    "db:backfill": "tsx scripts/backfill-releases.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "demo:record": "playwright test --config scripts/demo/playwright.demo.config.ts",
    "demo:record:admin": "DEMO_ADMIN=1 playwright test --config scripts/demo/playwright.demo.config.ts",
    "demo:record:cms": "DEMO_SPEC=record-cms-demo.spec.ts playwright test --config scripts/demo/playwright.demo.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@gsap/react": "^2.1.2",
    "@napi-rs/canvas": "1.0.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@puckeditor/core": "0.23.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.41.0",
    "mammoth": "1.13.0",
    "motion": "^13.2.0",
    "next": "15.5.28",
    "node-html-parser": "9.0.4",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
